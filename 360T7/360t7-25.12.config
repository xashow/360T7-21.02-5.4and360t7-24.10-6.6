# ImmortalWrt Configuration - Qihoo 360T7 (non-UBI squashfs 108M)
CONFIG_MODULES=y
CONFIG_HAVE_DOT_CONFIG=y
CONFIG_HOST_OS_LINUX=y
# CONFIG_HOST_OS_MACOS is not set

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y

CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_qihoo_360t7=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_qihoo_360t7=""

CONFIG_HAS_SUBTARGETS=y
CONFIG_HAS_DEVICES=y
CONFIG_TARGET_BOARD="mediatek"
CONFIG_TARGET_SUBTARGET="filogic"
CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a53"
CONFIG_DEFAULT_TARGET_OPTIMIZATION="-Os -pipe -mcpu=cortex-a53"
CONFIG_CPU_TYPE="cortex-a53"
CONFIG_LINUX_6_12=y
CONFIG_ARCH_64BIT=y
CONFIG_aarch64=y
CONFIG_ARCH="aarch64"
CONFIG_USES_DEVICETREE=y

# chasey仓库不需要手动勾选u-boot、trusted-firmware包，镜像流程自动生成
CONFIG_TARGET_ROOTFS_PARTSIZE=108
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_ITB=y

# ========== 下面保留你原本所有插件、luci、驱动等配置，直接追加在这后面 ==========


CONFIG_USES_SQUASHFS=y
CONFIG_USES_INITRAMFS=y
CONFIG_USES_SEPARATE_INITRAMFS=y
CONFIG_USES_ROOTFS_PART=y
CONFIG_NAND_SUPPORT=y
CONFIG_EMMC_SUPPORT=y
CONFIG_PCI_SUPPORT=y
CONFIG_PCIE_SUPPORT=y
CONFIG_USB_SUPPORT=y
CONFIG_GPIO_SUPPORT=y
CONFIG_PINCTRL_SUPPORT=y
CONFIG_RTC_SUPPORT=y
CONFIG_HAS_FPU=y
CONFIG_HAS_DT_OVERLAY_SUPPORT=y

