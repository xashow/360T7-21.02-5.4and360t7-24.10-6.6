# ImmortalWrt Configuration - Qihoo 360T7 (non-UBI)
CONFIG_MODULES=y
CONFIG_HAVE_DOT_CONFIG=y
CONFIG_HOST_OS_LINUX=y
# CONFIG_HOST_OS_MACOS is not set

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
# CONFIG_TARGET_PER_DEVICE_ROOTFS is not set

CONFIG_TARGET_mediatek_filogic_DEVICE_qihoo_360t7=y
# CONFIG_TARGET_mediatek_filogic_DEVICE_qihoo_360t7-ubi is not set
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_qihoo_360t7=""

CONFIG_HAS_SUBTARGETS=y
CONFIG_HAS_DEVICES=y
CONFIG_TARGET_BOARD="mediatek"
CONFIG_TARGET_SUBTARGET="filogic"
CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a53"
CONFIG_DEFAULT_TARGET_OPTIMIZATION="-Os -pipe -mcpu=cortex-a53"
CONFIG_CPU_TYPE="cortex-a53"
CONFIG_LINUX_6_12=y
CONFIG_ARCH_64BIT=y
CONFIG_aarch64=y
CONFIG_ARCH="aarch64"
CONFIG_USES_DEVICETREE=y

# 镜像基础依赖（必须开启，否则不打包itb）
CONFIG_PACKAGE_u-boot-mt7981_qihoo_360t7=y
CONFIG_PACKAGE_trusted-firmware-a-mt7981-spim-nand-ddr3=y

# Rootfs分区大小按需，非UBI原版分区不要超过108M
CONFIG_TARGET_ROOTFS_PARTSIZE=108
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_ITB=y

# 下面你原有所有插件、luci、驱动配置保留，直接追加到这个后面
# 注意：仓库内不存在的包，统一写成 # CONFIG_PACKAGE_xxx is not set，不要=y
